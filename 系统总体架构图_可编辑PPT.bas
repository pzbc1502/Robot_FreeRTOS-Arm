Attribute VB_Name = "EditableSystemArchitectureDiagram"
Option Explicit

' PowerPoint VBA module.
' ASCII source only. Chinese labels are generated by ChrW at runtime.
' Usage:
' 1. Open PowerPoint and press Alt+F11.
' 2. File -> Import File, import this .bas file.
' 3. Run CreateEditableSystemArchitectureDiagram.
'
' Every box, arrow and label is an editable PowerPoint shape.
' The arm photo is inserted as a normal picture object, so it can be moved,
' cropped, resized or replaced in PowerPoint.

