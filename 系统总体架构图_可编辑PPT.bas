    AddIconBadge sld, x + 17, y + 21, 36, accent, badge
    AddText sld, stepText, x + 62, y + 19, w - 74, 16, 9.5, accent, True, ppAlignLeft
    AddText sld, titleText, x + 62, y + 39, w - 74, 24, 15.5, textColor, True, ppAlignLeft
    AddText sld, subText, x + 62, y + 65, w - 74, 18, 9.8, mutedColor, False, ppAlignLeft
    AddBullets sld, x + 63, y + 89, w - 78, accent, mutedColor, bulletItems, 8.4
End Sub

