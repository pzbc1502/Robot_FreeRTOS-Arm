Private Sub AddCardBase(ByVal sld As Slide, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal accent As Long)
    Dim shp As Shape
    Set shp = AddRoundRect(sld, x + 3, y + 4, w, h, RGB(222, 230, 240), RGB(222, 230, 240), 0)
    shp.ZOrder msoSendToBack
    Set shp = AddRoundRect(sld, x, y, w, h, RGB(255, 255, 255), RGB(216, 224, 234), 1.2)
    Set shp = sld.Shapes.AddShape(msoShapeRectangle, x, y, 5, h)
    shp.Fill.ForeColor.RGB = accent
    shp.Line.Visible = msoFalse
End Sub

Private Sub AddBullets(ByVal sld As Slide, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal dotColor As Long, _
                       ByVal textColor As Long, ByVal bulletItems As Variant, ByVal fontSize As Single)
    Dim i As Long
    Dim yy As Single
    For i = LBound(bulletItems) To UBound(bulletItems)
        yy = y + (i - LBound(bulletItems)) * 15
        With sld.Shapes.AddShape(msoShapeOval, x, yy + 5, 4, 4)
            .Fill.ForeColor.RGB = dotColor
            .Line.Visible = msoFalse
        End With
        AddText sld, CStr(bulletItems(i)), x + 10, yy, w - 10, 12, fontSize, textColor, False, ppAlignLeft
    Next i
End Sub

Private Sub AddLegendItem(ByVal sld As Slide, ByVal x As Single, ByVal y As Single, ByVal colorValue As Long, ByVal labelText As String, ByVal textColor As Long)
    Dim shp As Shape
    Set shp = AddRoundRect(sld, x, y + 4, 14, 5, colorValue, colorValue, 0)
    AddText sld, labelText, x + 24, y - 2, 112, 14, 8.3, textColor, False, ppAlignLeft
End Sub

Private Sub AddNumberedItem(ByVal sld As Slide, ByVal x As Single, ByVal y As Single, ByVal colorValue As Long, ByVal numberText As String, ByVal labelText As String, ByVal textColor As Long)
    Dim shp As Shape
    Set shp = sld.Shapes.AddShape(msoShapeOval, x, y, 13, 13)
    shp.Fill.ForeColor.RGB = colorValue
    shp.Line.Visible = msoFalse
    SetShapeText shp, numberText, 7.5, RGB(255, 255, 255), True, ppAlignCenter
    AddText sld, labelText, x + 20, y - 2, 230, 16, 7.8, textColor, False, ppAlignLeft
End Sub

Private Sub AddIconBadge(ByVal sld As Slide, ByVal x As Single, ByVal y As Single, ByVal d As Single, ByVal colorValue As Long, ByVal labelText As String)
    Dim shp As Shape
    Set shp = sld.Shapes.AddShape(msoShapeOval, x, y, d, d)
    shp.Fill.ForeColor.RGB = RGB(248, 251, 255)
    shp.Line.ForeColor.RGB = colorValue
    shp.Line.Weight = 1.5
    SetShapeText shp, labelText, 7.5, colorValue, True, ppAlignCenter
End Sub

Private Sub AddPill(ByVal sld As Slide, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal labelText As String, _
                    ByVal fillColor As Long, ByVal textColor As Long, ByVal fontSize As Single)
    Dim shp As Shape
    Set shp = AddRoundRect(sld, x, y, w, h, fillColor, fillColor, 0)
    SetShapeText shp, labelText, fontSize, textColor, True, ppAlignCenter
End Sub

Private Sub AddLineLabel(ByVal sld As Slide, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal labelText As String, ByVal colorValue As Long)
    Dim shp As Shape
    Set shp = AddRoundRect(sld, x, y, w, h, RGB(255, 255, 255), colorValue, 1)
    SetShapeText shp, labelText, 7.5, colorValue, False, ppAlignCenter
End Sub

Private Sub AddArrow(ByVal sld As Slide, ByVal x1 As Single, ByVal y1 As Single, ByVal x2 As Single, ByVal y2 As Single, _
                     ByVal colorValue As Long, ByVal weight As Single, ByVal dashed As Boolean)
    Dim shp As Shape
    Set shp = sld.Shapes.AddConnector(msoConnectorStraight, x1, y1, x2, y2)
    With shp.Line
        .ForeColor.RGB = colorValue
        .Weight = weight
        .EndArrowheadStyle = msoArrowheadTriangle
        If dashed Then .DashStyle = msoLineDash
    End With
End Sub

Private Sub AddElbowArrow(ByVal sld As Slide, ByVal x1 As Single, ByVal y1 As Single, ByVal x2 As Single, ByVal y2 As Single, _
                          ByVal colorValue As Long, ByVal weight As Single, ByVal dashed As Boolean)
    Dim shp As Shape
    Set shp = sld.Shapes.AddConnector(msoConnectorElbow, x1, y1, x2, y2)
    With shp.Line
        .ForeColor.RGB = colorValue
        .Weight = weight
        .EndArrowheadStyle = msoArrowheadTriangle
        If dashed Then .DashStyle = msoLineDash
    End With
End Sub

Private Function AddRoundRect(ByVal sld As Slide, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, _
                              ByVal fillColor As Long, ByVal lineColor As Long, ByVal lineWeight As Single) As Shape
    Set AddRoundRect = sld.Shapes.AddShape(msoShapeRoundedRectangle, x, y, w, h)
    With AddRoundRect
        .Fill.ForeColor.RGB = fillColor
        If lineWeight <= 0 Then
            .Line.Visible = msoFalse
        Else
            .Line.Visible = msoTrue
            .Line.ForeColor.RGB = lineColor
            .Line.Weight = lineWeight
        End If
    End With
End Function

Private Sub AddText(ByVal sld As Slide, ByVal textValue As String, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, _
                    ByVal fontSize As Single, ByVal textColor As Long, ByVal isBold As Boolean, ByVal alignment As PpParagraphAlignment)
    Dim shp As Shape
    Set shp = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, x, y, w, h)
    SetShapeText shp, textValue, fontSize, textColor, isBold, alignment
End Sub

Private Sub SetShapeText(ByVal shp As Shape, ByVal textValue As String, ByVal fontSize As Single, ByVal textColor As Long, _
                         ByVal isBold As Boolean, ByVal alignment As PpParagraphAlignment)
    With shp.TextFrame
        .MarginLeft = 1
        .MarginRight = 1
        .MarginTop = 1
        .MarginBottom = 1
        .VerticalAnchor = msoAnchorMiddle
        .WordWrap = msoTrue
        With .TextRange
            .Text = textValue
            .Font.Name = FONT_NAME
            .Font.Size = fontSize
            If isBold Then
                .Font.Bold = msoTrue
            Else
                .Font.Bold = msoFalse
            End If
            .Font.Color.RGB = textColor
            .ParagraphFormat.Alignment = alignment
        End With
    End With
End Sub

Private Sub FitShape(ByVal shp As Shape, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single)
    Dim r As Single
    If shp.Width <= 0 Or shp.Height <= 0 Then Exit Sub
    r = w / shp.Width
    If h / shp.Height < r Then r = h / shp.Height
    shp.Width = shp.Width * r
    shp.Height = shp.Height * r
    shp.Left = x + (w - shp.Width) / 2
    shp.Top = y + (h - shp.Height) / 2
End Sub

Private Function T(ByVal codes As String) As String
    Dim parts() As String
    Dim i As Long
    Dim out As String
    codes = Trim$(codes)
    If Len(codes) = 0 Then
        T = ""
        Exit Function
    End If
    parts = Split(codes, " ")
    For i = LBound(parts) To UBound(parts)
        If Len(parts(i)) > 0 Then out = out & ChrW$(CLng("&H" & parts(i)))
    Next i
    T = out
End Function
