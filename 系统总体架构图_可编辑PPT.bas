                        ByVal accent As Long, ByVal badge As String, ByVal titleText As String, ByVal lines As Variant, _
                        ByVal textColor As Long, ByVal mutedColor As Long)
    AddCardBase sld, x, y, w, h, accent
    AddIconBadge sld, x + 16, y + 18, 32, accent, badge
    AddText sld, titleText, x + 60, y + 18, w - 70, 19, 12.5, textColor, True, ppAlignLeft
    AddText sld, CStr(lines(0)), x + 60, y + 42, w - 68, 14, 8.3, mutedColor, False, ppAlignLeft
