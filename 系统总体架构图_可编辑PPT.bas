Private Sub AddStepCard(ByVal sld As Slide, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, _
                        ByVal accent As Long, ByVal badge As String, ByVal stepText As String, ByVal titleText As String, _
